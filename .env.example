# 本地开发若需科学上网访问 Gemini，设置 USE_PROXY=true 并填写 PROXY_URL；服务器部署保持 false
USE_PROXY=false
PROXY_URL=http://127.0.0.1:1080

GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=./models/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=web_novel_corpus_local
CHROMA_BATCH_SIZE=100
STYLE_TEMPLATES_FILE=./data/style_templates.json
SAMPLES_DIR=./data/samples
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_UPLOAD_MB=10
