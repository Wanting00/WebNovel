# 本地开发：走 Shadowsocks/Clash 本地代理才能连上 Gemini（本地需要时手动改回 true）
USE_PROXY=false
PROXY_URL=http://127.0.0.1:1080

# Gemini API Key: 部署时在服务器上手动填写，不要提交真实值到 git
GOOGLE_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=./models/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=web_novel_corpus_local
CHROMA_BATCH_SIZE=100
STYLE_TEMPLATES_FILE=./data/style_templates.json
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_UPLOAD_MB=10
